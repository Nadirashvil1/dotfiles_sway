{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "bottom",
  "spacing": 0,
  "height": 28,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "group/tray-drawer",
    "custom/last-updated",
    "cpu",
    "memory",
    "disk",
    "network",
    "pulseaudio",
    "battery",
    "clock"
  ],
  "group/tray-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 200
    },
    "modules": [
      "custom/expand",
      "tray"
    ]
  },
  "custom/expand": {
    "format": "\u276e",
    "tooltip": false
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
    "on-click": "activate"
  },
  "cpu": {
    "interval": 2,
    "format": "cpu {usage}%",
    "on-click": "foot -e btop"
  },
  "memory": {
    "format": "mem {used:0.1f}gb",
    "interval": 2,
    "on-click": "foot -e btop"
  },
  "custom/last-updated": {
    "exec": "~/.local/bin/sway-rice/last-updated",
    "return-type": "json",
    "interval": 3600,
    "format": "days {text}"
  },
  "disk": {
    "interval": 30,
    "format": "disk {percentage_used}%",
    "tooltip-format": "Used: {used}\nFree: {free}\nTotal: {total}",
    "path": "/",
    "on-click": "foot -e sh -c \"duf; printf '\\nPress Enter to close.'; read -r reply\""
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:L%A %d %B}",
    "tooltip": false
  },
  "network": {
    "format-wifi": "wifi {essid}",
    "format-ethernet": "eth {ifname}",
    "format-disconnected": "wifi --",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-ethernet": "\u21e3{bandwidthDownBytes}  \u21e1{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "nm-connection-editor"
  },
  "battery": {
    "format": "bat {capacity}%",
    "format-discharging": "bat {capacity}%",
    "format-charging": "bat {capacity}%",
    "format-plugged": "bat {capacity}%",
    "tooltip-format-discharging": "{power:>1.0f}W\u2193 {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W\u2191 {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "vol {volume}%",
    "scroll-step": 5,
    "format-muted": "vol muted"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 4
  },
  "mpris": {
    "format": "{artist} \u2022 {title}",
    "format-paused": "{artist} \u2022 {title}",
    "format-stopped": "",
    "max-length": 55
  }
}
